        "z": "161772d8cb84f271",
        "name": "Lab 4",
        "func": "let mq5_raw = msg.payload.mq5_raw;\nlet mq5_avg = msg.payload.mq5_avg;\nlet mq5_voltage = msg.payload.mq5_voltage;\nlet risk_level = msg.payload.risk_level;\nlet ambient_temp = msg.payload.ambient_temp;\nlet body_temp = msg.payload.body_temp;\nlet fever_flag = msg.payload.fever_flag;\nlet bmp_temp = msg.payload.bmp_temp;\nlet bmp_pressure = msg.payload.bmp_pressure;\nlet bmp_altitude = msg.payload.bmp_altitude;\nlet date_col = msg.payload.date;\nlet time_col = msg.payload.time;\n\nmsg.topic = `\nINSERT INTO sensor_data (\n    mq5_raw, mq5_avg, mq5_voltage, risk_level,\n    ambient_temp, body_temp, fever_flag,\n    bmp_temp, bmp_pressure, bmp_altitude,\n    date_col, time_col\n)\nVALUES (\n    ${mq5_raw}, ${mq5_avg}, ${mq5_voltage}, '${risk_level}',\n    ${ambient_temp}, ${body_temp}, ${fever_flag},\n    ${bmp_temp}, ${bmp_pressure}, ${bmp_altitude},\n    '${date_col}', '${time_col}'\n)\n`;\n\nreturn msg;",
